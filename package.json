{
  "name": "web-agent-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Browser automation MCP server: one persistent Chrome profile, ref-based targeting, bulk page collection, and server-side scripting.",
  "type": "module",
  "scripts": {
    "daemon": "bun src/server.ts --daemon",
    "daemon:status": "bun src/server.ts --daemon-status",
    "daemon:stop": "bun src/server.ts --daemon-stop",
    "import-profile": "bun src/server.ts --import-profile",
    "build:binary": "bun scripts/build-binary.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src scripts --parallel=$(( ($(nproc) + 1) / 2 ))",
    "test:e2e": "bun test --timeout 300000 e2e --parallel=$(( ($(nproc) + 1) / 2 )) --timings=e2e/timings.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "patchright": "1.64.3",
    "playwright-core": "1.65.1",
    "tldts": "7.5.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mswjs/interceptors": "0.45.12",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "1.4.5",
    "msw": "3.0.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
