{
  "name": "web-agent-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser automation MCP server: one persistent Chrome profile, ref-based targeting, bulk page collection, and server-side scripting.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "daemon": "node src/server.ts --daemon",
    "daemon:status": "node src/server.ts --daemon-status",
    "daemon:stop": "node src/server.ts --daemon-stop",
    "import-profile": "node src/server.ts --import-profile",
    "dev": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test \"e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "patchright": "1.64.3",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
